/* ============================================
   THE STACK — Design System
   Centralized CSS for all Stack pages
   Version: 1.0.0
   ============================================ */

/* ============================================
   CSS TOKENS (Custom Properties)
   ============================================ */

:root {
    /* Background Colors */
    --bg-primary: #0a0b0f;
    --bg-secondary: #12141c;
    --bg-tertiary: #1a1d28;
    --bg-glass: rgba(255, 255, 255, 0.03);

    /* Text Colors */
    --text-primary: #f0f2f8;
    --text-secondary: #a0a8c0;
    --text-muted: #6b7394;

    /* Accent Colors */
    --accent-blue: #4a9eff;
    --accent-green: #34d399;
    --accent-amber: #fbbf24;
    --accent-red: #fb7185;
    --accent-purple: #a78bfa;

    /* Borders */
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-strong: rgba(255, 255, 255, 0.12);

    /* Typography */
    --font-serif: 'Newsreader', Georgia, serif;
    --font-sans: 'Inter', -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;

    /* Spacing Scale */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 64px;

    /* Border Radius */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-full: 100px;

    /* Shadows */
    --shadow-glow: 0 0 60px rgba(74, 158, 255, 0.12);
    --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.4);

    /* Transitions */
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
}

/* Light Mode Override */
[data-theme="light"] {
    --bg-primary: #fefdf8;
    --bg-secondary: #f8f7f4;
    --bg-tertiary: #fff;
    --bg-glass: rgba(0, 0, 0, 0.02);
    --text-primary: #1a1a1a;
    --text-secondary: #4a4a4a;
    --text-muted: #888;
    --border-subtle: rgba(0, 0, 0, 0.06);
    --border-strong: rgba(0, 0, 0, 0.12);
    --shadow-glow: 0 0 40px rgba(0, 0, 0, 0.05);
    --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.08);
}

/* ============================================
   BASE RESET
   ============================================ */

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.7;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
}

/* ============================================
   TYPOGRAPHY
   ============================================ */

.prose {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.9;
    color: var(--text-secondary);
}

.prose p {
    margin-bottom: 1.5rem;
}

.prose strong {
    color: var(--text-primary);
}

.prose em {
    font-style: italic;
}

/* ============================================
   HEADER & NAVIGATION
   ============================================ */

header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(20px);
}

.header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.1rem;
}

.brand-icon {
    color: var(--accent-blue);
    font-size: 1.3rem;
}

.header-controls {
    display: flex;
    align-items: center;
    gap: 16px;
}

/* ============================================
   DEPTH SELECTOR
   ============================================ */

.depth-selector {
    display: flex;
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    padding: 4px;
}

.depth-btn {
    padding: 8px 16px;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s var(--ease);
}

.depth-btn:hover {
    color: var(--text-primary);
}

.depth-btn.active {
    background: var(--bg-primary);
    color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

/* ============================================
   THEME TOGGLE
   ============================================ */

.theme-toggle {
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.2s var(--ease);
}

.theme-toggle:hover {
    border-color: var(--accent-blue);
}

/* ============================================
   PROGRESS BAR
   ============================================ */

.progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
    z-index: 1000;
    transition: width 0.1s linear;
}

/* ============================================
   HERO SECTION
   ============================================ */

.hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 24px 60px;
    text-align: center;
}

.hero-kicker {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-blue);
    margin-bottom: 16px;
}

.hero-stat {
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-red), var(--accent-amber));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
}

.hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.3;
    margin: 24px 0;
}

.hero-title strong {
    font-weight: 600;
}

.hero-stats-row {
    display: flex;
    justify-content: center;
    gap: 48px;
    margin-top: 32px;
    flex-wrap: wrap;
}

.stat-item {
    text-align: center;
}

.stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
}

.stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 4px;
}

/* ============================================
   MAIN CONTENT
   ============================================ */

.main {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px 80px;
}

.section {
    margin-bottom: 64px;
}

.section-kicker {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-blue);
    margin-bottom: 8px;
}

.section-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    margin-bottom: 24px;
}

/* ============================================
   EVIDENCE CHIPS
   ============================================ */

.evidence-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: var(--accent-green);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s var(--ease);
}

.evidence-chip:hover {
    background: rgba(52, 211, 153, 0.2);
    transform: scale(1.02);
}

.evidence-chip.type-estimate {
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.3);
    color: var(--accent-amber);
}

.evidence-chip.type-quote {
    background: rgba(74, 158, 255, 0.1);
    border-color: rgba(74, 158, 255, 0.3);
    color: var(--accent-blue);
}

/* ============================================
   INSIGHT BOX
   ============================================ */

.insight {
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.08), rgba(74, 158, 255, 0.05));
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin: 32px 0;
}

.insight-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent-purple);
    margin-bottom: 8px;
}

.insight-text {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.7;
}

/* ============================================
   POLL
   ============================================ */

.poll-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin: 32px 0;
}

.poll-question {
    font-weight: 600;
    margin-bottom: 16px;
}

.poll-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.poll-option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-tertiary);
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s var(--ease);
}

.poll-option:hover {
    border-color: var(--accent-blue);
    background: var(--bg-secondary);
}

.poll-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--width);
    background: rgba(74, 158, 255, 0.35);
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    transition: width 0.5s var(--ease);
}

.poll-option-label {
    position: relative;
    z-index: 1;
    color: var(--text-primary);
    font-weight: 500;
}

.poll-percent {
    position: relative;
    z-index: 1;
    font-weight: 700;
    color: #fff;
    background: var(--accent-blue);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
}

.poll-meta {
    margin-top: 16px;
    font-size: 0.8rem;
    color: var(--text-secondary);
}

/* ============================================
   QUIZ
   ============================================ */

.quiz-card {
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(74, 158, 255, 0.05));
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin: 32px 0;
}

.quiz-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

.quiz-title {
    font-weight: 600;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.quiz-title-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, var(--accent-purple), #7c3aed);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.quiz-progress {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.quiz-score {
    padding: 4px 12px;
    background: var(--bg-primary);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--accent-purple);
}

.quiz-question {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin-bottom: 20px;
    line-height: 1.6;
}

.quiz-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.quiz-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--bg-secondary);
    border: 2px solid var(--border-subtle);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s var(--ease);
}

.quiz-option:hover {
    border-color: var(--accent-purple);
    transform: translateX(4px);
}

.quiz-option.correct {
    border-color: var(--accent-green);
    background: rgba(52, 211, 153, 0.15);
}

.quiz-option.wrong {
    border-color: var(--accent-red);
    background: rgba(251, 113, 133, 0.15);
}

.quiz-option-letter {
    width: 28px;
    height: 28px;
    background: var(--bg-primary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.85rem;
    flex-shrink: 0;
}

.quiz-option.correct .quiz-option-letter {
    background: var(--accent-green);
    color: #fff;
    border-color: var(--accent-green);
}

.quiz-option.wrong .quiz-option-letter {
    background: var(--accent-red);
    color: #fff;
    border-color: var(--accent-red);
}

.quiz-feedback {
    margin-top: 20px;
    padding: 16px;
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    display: none;
}

.quiz-feedback.visible {
    display: block;
    animation: slideIn 0.3s var(--ease);
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.quiz-next-btn {
    padding: 10px 20px;
    background: var(--accent-purple);
    border: none;
    border-radius: var(--radius-sm);
    color: #fff;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--ease);
}

.quiz-next-btn:hover {
    transform: scale(1.02);
}

.quiz-result {
    text-align: center;
    padding: 32px 16px;
}

.quiz-result-score {
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent-purple);
}

.quiz-result-badge {
    display: inline-block;
    padding: 8px 16px;
    background: linear-gradient(135deg, var(--accent-purple), #7c3aed);
    color: #fff;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.9rem;
    margin: 16px 0;
}

/* ============================================
   VIP COMMENTS
   ============================================ */

.vip-comment {
    display: flex;
    gap: 16px;
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.08), rgba(74, 158, 255, 0.05));
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: var(--radius-md);
    padding: 20px;
    margin: 32px 0;
}

.vip-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
}

.vip-header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.vip-badge {
    padding: 2px 8px;
    background: rgba(167, 139, 250, 0.2);
    color: var(--accent-purple);
    border-radius: var(--radius-full);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.vip-name {
    font-weight: 600;
    font-size: 0.9rem;
}

.vip-time {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.vip-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
}

.vip-votes {
    display: flex;
    gap: 12px;
    margin-top: 12px;
}

.vip-vote {
    padding: 4px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s var(--ease);
}

.vip-vote:hover {
    border-color: var(--accent-blue);
}

/* ============================================
   FOOTER
   ============================================ */

.footer {
    border-top: 1px solid var(--border-subtle);
    padding: 48px 24px;
    text-align: center;
    margin-top: 64px;
}

.footer-legend {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 24px;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
}

.legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.legend-dot.explicit {
    background: var(--accent-green);
}

.legend-dot.estimate {
    background: var(--accent-amber);
}

.legend-dot.quote {
    background: var(--accent-blue);
}

.footer-note {
    font-size: 0.85rem;
    color: var(--text-muted);
}

/* ============================================
   MODAL
   ============================================ */

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s var(--ease);
    z-index: 1000;
}

.modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.modal {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    width: 90%;
    max-width: 500px;
    box-shadow: var(--shadow-card);
    transform: scale(0.95) translateY(20px);
    transition: transform 0.3s var(--ease);
}

.modal-overlay.active .modal {
    transform: scale(1) translateY(0);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--border-subtle);
}

.modal-close {
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-primary);
    border-radius: var(--radius-sm);
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
}

.modal-close:hover {
    border-color: var(--accent-red);
    color: var(--accent-red);
}

.modal-body {
    padding: 20px;
}

.modal-excerpt {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    padding: 16px;
    background: rgba(74, 158, 255, 0.05);
    border-left: 3px solid var(--accent-blue);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-secondary);
    margin-bottom: 16px;
}

.modal-source {
    font-size: 0.85rem;
    color: var(--text-muted);
}

/* ============================================
   DEPTH VISIBILITY
   Content elements are hidden by default, shown based on body class
   CRITICAL: Ensure body is NEVER hidden
   ============================================ */

/* Ensure body is always visible regardless of depth class */
body.depth-skim,
body.depth-read,
body.depth-audit {
    display: block !important;
}

.prose.depth-read,
.insight.depth-read,
div.depth-read,
section.depth-read,
.prose.depth-audit,
.insight.depth-audit,
div.depth-audit,
section.depth-audit {
    display: none;
}

body.depth-read .prose.depth-read,
body.depth-read .insight.depth-read,
body.depth-read div.depth-read,
body.depth-read section.depth-read {
    display: block;
}

body.depth-audit .prose.depth-read,
body.depth-audit .insight.depth-read,
body.depth-audit div.depth-read,
body.depth-audit section.depth-read,
body.depth-audit .prose.depth-audit,
body.depth-audit .insight.depth-audit,
body.depth-audit div.depth-audit,
body.depth-audit section.depth-audit {
    display: block;
}

/* ============================================
   RESPONSIVE
   ============================================ */

@media (max-width: 768px) {
    .depth-selector {
        display: none;
    }

    .hero-stat {
        font-size: 6rem;
    }

    .hero-stats-row {
        gap: 24px;
    }

    .vip-comment {
        flex-direction: column;
    }
}