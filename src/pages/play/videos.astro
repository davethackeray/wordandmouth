---
import Base from '../../layouts/Base.astro';
---

<Base title="Videos" description="Presentations, demos, and YouTube content on building with AI">
  <section class="hero-small">
    <a href="/play" class="back-link">← Play</a>
    <h1>Videos</h1>
    <p>Presentations, demos, and YouTube content on building with AI.</p>
  </section>
  
  <!-- Featured Video -->
  <section class="section">
    <h2 class="section-label">Featured</h2>
    <div class="video-featured">
      <p class="coming-soon">Video content coming soon. Will include project demos, presentation recordings, and tutorials.</p>
    </div>
  </section>
  
  <!-- Video Archive -->
  <section class="section">
    <h2 class="section-label">All Videos</h2>
    <div class="videos-grid">
      <!-- Videos will be dynamically loaded -->
      <p class="coming-soon">Video archive coming soon.</p>
    </div>
  </section>
  
  <!-- YouTube Link -->
  <section class="section cta-section">
    <h2>Subscribe on YouTube</h2>
    <p>Get notified when new videos drop.</p>
    <a href="https://youtube.com/@davethackeray" target="_blank" class="cta-button">YouTube Channel →</a>
  </section>
</Base>

<style>
  .hero-small {
    padding: 10rem 2rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .back-link {
    display: inline-block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }
  
  .back-link:hover {
    color: var(--accent);
  }
  
  .hero-small h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }
  
  .hero-small p {
    color: var(--muted);
    font-size: 1.2rem;
  }
  
  .video-featured {
    background: #111;
    padding: 2rem;
    border-left: 3px solid var(--accent);
  }
  
  .coming-soon {
    color: var(--muted);
    font-style: italic;
  }
  
  .videos-grid {
    background: #111;
    padding: 2rem;
  }
  
  .cta-section {
    text-align: center;
  }
  
  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  
  .cta-section p {
    color: var(--muted);
    margin-bottom: 2rem;
  }
</style>
