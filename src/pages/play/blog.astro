---
import Base from '../../layouts/Base.astro';
---

<Base title="Blog" description="Written explorations of ideas, observations, and lessons learned">
  <section class="hero-small">
    <a href="/play" class="back-link">← Play</a>
    <h1>Blog</h1>
    <p>Written explorations of ideas, observations, and lessons learned.</p>
  </section>
  
  <!-- Posts will be dynamically loaded from content collections -->
  <section class="section">
    <h2 class="section-label">Latest Posts</h2>
    <div class="posts-grid">
      <p class="coming-soon">First posts coming soon. In the meantime, check out my <a href="https://medium.com/@davethackeray">Medium archive</a>.</p>
    </div>
  </section>
  
  <!-- Filter by Tenet -->
  <section class="section">
    <h2 class="section-label">Browse by Topic</h2>
    <div class="topic-tags">
      <a href="/story" class="topic-tag">Story</a>
      <a href="/clarity" class="topic-tag">Clarity</a>
      <a href="/insight" class="topic-tag">Insight</a>
      <a href="/ai" class="topic-tag">AI</a>
      <a href="/growth" class="topic-tag">Growth</a>
    </div>
  </section>
</Base>

<style>
  .hero-small {
    padding: 10rem 2rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .back-link {
    display: inline-block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }
  
  .back-link:hover {
    color: var(--accent);
  }
  
  .hero-small h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }
  
  .hero-small p {
    color: var(--muted);
    font-size: 1.2rem;
  }
  
  .coming-soon {
    color: var(--muted);
    padding: 2rem;
    background: #111;
  }
  
  .coming-soon a {
    color: var(--accent);
  }
  
  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  
  .topic-tag {
    background: rgba(255, 107, 53, 0.15);
    color: var(--accent);
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.2s;
  }
  
  .topic-tag:hover {
    background: rgba(255, 107, 53, 0.3);
  }
</style>
