---
import Base from '../../layouts/Base.astro';
---

<Base title="Podcast" description="Audio conversations about projects, ideas, and AI">
  <section class="hero-small">
    <a href="/play" class="back-link">← Play</a>
    <h1>Podcast</h1>
    <p>Audio conversations about projects, ideas, and the intersection of AI and creativity.</p>
  </section>
  
  <!-- Latest Episode -->
  <section class="section">
    <h2 class="section-label">Latest Episode</h2>
    <div class="episode-featured">
      <p class="coming-soon">First episode dropping soon. Topics will include AI building, Storyselling, and behind-the-scenes on my projects.</p>
    </div>
  </section>
  
  <!-- Episode Archive -->
  <section class="section">
    <h2 class="section-label">All Episodes</h2>
    <div class="episodes-list">
      <!-- Episodes will be dynamically loaded -->
      <p class="coming-soon">Episode archive coming soon.</p>
    </div>
  </section>
  
  <!-- Subscribe Options -->
  <section class="section">
    <h2 class="section-label">Listen & Subscribe</h2>
    <div class="subscribe-options">
      <span class="subscribe-badge">Apple Podcasts</span>
      <span class="subscribe-badge">Spotify</span>
      <span class="subscribe-badge">YouTube</span>
      <span class="subscribe-badge">RSS</span>
    </div>
    <p class="subscribe-note">Links coming when we launch.</p>
  </section>
</Base>

<style>
  .hero-small {
    padding: 10rem 2rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .back-link {
    display: inline-block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }
  
  .back-link:hover {
    color: var(--accent);
  }
  
  .hero-small h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }
  
  .hero-small p {
    color: var(--muted);
    font-size: 1.2rem;
  }
  
  .episode-featured {
    background: #111;
    padding: 2rem;
    border-left: 3px solid var(--accent);
  }
  
  .coming-soon {
    color: var(--muted);
    font-style: italic;
  }
  
  .episodes-list {
    background: #111;
    padding: 2rem;
  }
  
  .subscribe-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .subscribe-badge {
    background: #222;
    color: var(--muted);
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
  
  .subscribe-note {
    color: var(--muted);
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
