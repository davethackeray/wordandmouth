---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

// Helper to get files from a directory with status extraction
async function getPipelineContent(type) {
  const projectRoot = process.cwd(); 
  const dirPath = path.join(projectRoot, 'content', 'pipeline', type);
  
  try {
    const files = await fs.readdir(dirPath);
    const contentFiles = files.filter(f => f.endsWith('.md'));
    
    const items = await Promise.all(contentFiles.map(async (filename) => {
      const filePath = path.join(dirPath, filename);
      try {
        const content = await fs.readFile(filePath, 'utf-8');
        
        // Extract title
        let title = filename.replace('.md', '').replace(/-/g, ' ');
        const frontmatterMatch = content.match(/^title:\s*["']?(.*?)["']?$/m);
        const headerMatch = content.match(/^#\s+(.*)$/m);
        
        if (frontmatterMatch) {
          title = frontmatterMatch[1];
        } else if (headerMatch) {
          title = headerMatch[1];
        }
        
        // Extract status from frontmatter or inline marker
        let status = 'draft'; // default
        const statusMatch = content.match(/^(?:\*\*)?status(?:\*\*)?:\s*["']?(.*?)["']?\s*$/im);
        if (statusMatch) {
          const s = statusMatch[1].toLowerCase();
          if (s.includes('ready') || s.includes('final')) status = 'ready';
          else if (s.includes('review')) status = 'review';
          else if (s.includes('published')) status = 'published';
          else status = 'draft';
        }
        
        // Skip published items - they shouldn't be in pipeline
        if (status === 'published') return null;
        
        const stats = await fs.stat(filePath);
        
        return {
          slug: filename.replace('.md', ''),
          filename,
          title,
          status,
          created: stats.birthtime,
          modified: stats.mtime,
          size: stats.size
        };
      } catch (e) {
        console.warn(`Error reading file ${filename}:`, e);
        return null;
      }
    }));
    
    // Sort by most recently modified first
    return items.filter(i => i !== null).sort((a, b) => b.modified - a.modified);
  } catch (e) {
    if (e.code === 'ENOENT') {
      console.warn(`[Pipeline] Content directory not found: ${dirPath}.`);
      return [];
    }
    console.error(`Error reading ${type} directory from ${dirPath}:`, e);
    return [];
  }
}

const newsletters = await getPipelineContent('newsletter');
const podcasts = await getPipelineContent('podcast');
---

<Base title="Content Pipeline | Word And Mouth Admin">
  <main class="pipeline-page">
    <div class="content-wrapper">
      <header class="pipeline-header">
        <h1>Content Pipeline</h1>
        <p>Drafts and briefs in progress. Items marked "ready" are awaiting publication.</p>
      </header>

      <div class="pipeline-grid">
        <section class="pipeline-column">
          <h2>
            <span class="icon">🎙️</span> 
            Podcasts 
            <span class="count">{podcasts.length}</span>
          </h2>
          <div class="card-list">
            {podcasts.map(item => (
              <a href={`/pipeline/podcast/${item.slug}`} class="pipeline-card">
                <div class="card-header">
                  <h3>{item.title}</h3>
                  <span class={`status-badge status-${item.status}`}>{item.status}</span>
                </div>
                <div class="meta">
                  <span class="filename">{item.filename}</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="pipeline-column">
          <h2>
            <span class="icon">📰</span> 
            Newsletters 
            <span class="count">{newsletters.length}</span>
          </h2>
          <div class="card-list">
            {newsletters.map(item => (
              <a href={`/pipeline/newsletter/${item.slug}`} class="pipeline-card">
                <div class="card-header">
                  <h3>{item.title}</h3>
                  <span class={`status-badge status-${item.status}`}>{item.status}</span>
                </div>
                <div class="meta">
                  <span class="filename">{item.filename}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</Base>

<style>
  .pipeline-page {
    padding-top: 160px;
    min-height: 100vh;
    background: #050505;
  }

  .content-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .pipeline-header {
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .pipeline-header p {
    color: var(--muted);
    font-size: 1.2rem;
  }

  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 4rem;
  }

  .pipeline-column h2 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent);
  }

  .count {
    background: rgba(255, 255, 255, 0.1);
    color: var(--muted);
    font-size: 0.9rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 400;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pipeline-card {
    background: #111;
    border: 1px solid var(--border);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    display: block;
  }

  .pipeline-card:hover {
    border-color: var(--accent);
    transform: translateX(4px);
    background: #161616;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .pipeline-card h3 {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.4;
    flex: 1;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .status-draft {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .status-review {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .status-ready {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: monospace;
  }

  @media (max-width: 768px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
