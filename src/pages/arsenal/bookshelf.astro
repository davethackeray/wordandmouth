---
import Base from '../../layouts/Base.astro';
---

<Base title="The Arsenal — Books That Change How You Solve Problems | Word And Mouth">
  <section class="bookshelf-hero">
    <a href="/arsenal/" class="back-link">← The Arsenal</a>
    <div class="hero-badge">THE BOOKSHELF</div>
    <h1>15 Books. Zero Fluff.</h1>
    <p class="hero-sub">
      These aren't "business books." They're weapons-grade problem-solving frameworks 
      disguised as paperbacks. Each one has shaped how we think, diagnose, and fix.
    </p>
    <p class="hero-prescription">
      <strong>Not sure where to start?</strong> 
      <a href="#prescription">Take the 3-question diagnostic →</a>
    </p>
  </section>

  <!-- Systems Architects -->
  <section class="book-section">
    <div class="section-header">
      <span class="section-icon">🏗️</span>
      <div>
        <h2>Systems Architects</h2>
        <p class="section-desc">Understanding the machine. Read these if your problem is structural.</p>
      </div>
    </div>

    <div class="book-grid">
      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">01</span>
          <span class="book-tag">SYSTEMS</span>
        </div>
        <h3>Thinking in Systems</h3>
        <p class="book-author">Donella Meadows</p>
        <p class="book-if"><strong>Read this if:</strong> You keep solving the same problem over and over.</p>
        <blockquote class="book-quote">
          "We can't impose our will on a system. We can dance with it."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Leverage Points — where small shifts create big changes</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">02</span>
          <span class="book-tag">PHILOSOPHY</span>
        </div>
        <h3>Finite and Infinite Games</h3>
        <p class="book-author">James P. Carse</p>
        <p class="book-if"><strong>Read this if:</strong> You're obsessed with "winning" but unclear what winning means.</p>
        <blockquote class="book-quote">
          "A finite game is played for the purpose of winning, an infinite game for the purpose of continuing the play."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Infinite Mindset — playing to keep playing, not to win</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">03</span>
          <span class="book-tag">FUTURES</span>
        </div>
        <h3>The Art of the Long View</h3>
        <p class="book-author">Peter Schwartz</p>
        <p class="book-if"><strong>Read this if:</strong> You're paralyzed by uncertainty about the future.</p>
        <blockquote class="book-quote">
          "Scenarios are not predictions. They are stories about the way the world might turn out."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Scenario Planning — rehearsing for multiple futures</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">04</span>
          <span class="book-tag">STRATEGY</span>
        </div>
        <h3>Good Strategy Bad Strategy</h3>
        <p class="book-author">Richard Rumelt</p>
        <p class="book-if"><strong>Read this if:</strong> Your strategy is actually just a list of goals.</p>
        <blockquote class="book-quote">
          "A good strategy honestly acknowledges the challenges being faced and provides an approach to overcoming them."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">The Kernel — Diagnosis + Guiding Policy + Coherent Actions</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">05</span>
          <span class="book-tag">COMPLEXITY</span>
        </div>
        <h3>Cynefin</h3>
        <p class="book-author">Dave Snowden</p>
        <p class="book-if"><strong>Read this if:</strong> You apply "best practices" to problems where they don't work.</p>
        <blockquote class="book-quote">
          "We can know more than we can tell."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">5 Domains — Clear, Complicated, Complex, Chaotic, Confused</span>
        </div>
      </article>
    </div>
  </section>

  <!-- Creative Interrogators -->
  <section class="book-section">
    <div class="section-header">
      <span class="section-icon">🔍</span>
      <div>
        <h2>Creative Interrogators</h2>
        <p class="section-desc">Asking better questions. Read these if your problem is unclear.</p>
      </div>
    </div>

    <div class="book-grid">
      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">06</span>
          <span class="book-tag">INQUIRY</span>
        </div>
        <h3>A More Beautiful Question</h3>
        <p class="book-author">Warren Berger</p>
        <p class="book-if"><strong>Read this if:</strong> You're jumping to answers before understanding the question.</p>
        <blockquote class="book-quote">
          "The most creative, successful people tend to be expert questioners."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Why → What If → How cycle of inquiry</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">07</span>
          <span class="book-tag">VALIDATION</span>
        </div>
        <h3>The Mom Test</h3>
        <p class="book-author">Rob Fitzpatrick</p>
        <p class="book-if"><strong>Read this if:</strong> People keep telling you your idea is great (but it's not).</p>
        <blockquote class="book-quote">
          "It's not their responsibility to tell you the truth. It's your responsibility to find it."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Ask about past behavior, not future intentions</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">08</span>
          <span class="book-tag">BELIEFS</span>
        </div>
        <h3>Liminal Thinking</h3>
        <p class="book-author">Dave Gray</p>
        <p class="book-if"><strong>Read this if:</strong> You're stuck in a worldview that's no longer serving you.</p>
        <blockquote class="book-quote">
          "Create the change you want by changing the way you think."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">The Pyramid of Belief — how reality is constructed</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">09</span>
          <span class="book-tag">CREATIVITY</span>
        </div>
        <h3>Lateral Thinking</h3>
        <p class="book-author">Edward de Bono</p>
        <p class="book-if"><strong>Read this if:</strong> Your logic keeps digging the same hole deeper.</p>
        <blockquote class="book-quote">
          "You cannot dig a hole in a different place by digging the same hole deeper."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Provocation & Random Entry — breaking patterns</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">10</span>
          <span class="book-tag">SURVIVAL</span>
        </div>
        <h3>Orbiting the Giant Hairball</h3>
        <p class="book-author">Gordon MacKenzie</p>
        <p class="book-if"><strong>Read this if:</strong> You're creative but trapped in corporate gravity.</p>
        <blockquote class="book-quote">
          "If you go to your grave without painting your masterpiece, it will not get painted."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Orbiting — being of the company, not crushed by it</span>
        </div>
      </article>
    </div>
  </section>

  <!-- Hard-Nosed Operators -->
  <section class="book-section">
    <div class="section-header">
      <span class="section-icon">⚡</span>
      <div>
        <h2>Hard-Nosed Operators</h2>
        <p class="section-desc">Execution and decision. Read these if your problem is action.</p>
      </div>
    </div>

    <div class="book-grid">
      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">11</span>
          <span class="book-tag">DECISIONS</span>
        </div>
        <h3>Decisive</h3>
        <p class="book-author">Chip & Dan Heath</p>
        <p class="book-if"><strong>Read this if:</strong> You're paralyzed by analysis or keep making the same mistakes.</p>
        <blockquote class="book-quote">
          "Our brains are wired to make bad decisions due to biases."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">WRAP — Widen, Reality-test, Attain distance, Prepare to fail</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">12</span>
          <span class="book-tag">COMMUNICATION</span>
        </div>
        <h3>The Pyramid Principle</h3>
        <p class="book-author">Barbara Minto</p>
        <p class="book-if"><strong>Read this if:</strong> People don't understand your recommendations.</p>
        <blockquote class="book-quote">
          "Start with the answer."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">SCQA — Situation, Complication, Question, Answer</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">13</span>
          <span class="book-tag">INTELLIGENCE</span>
        </div>
        <h3>Psychology of Intelligence Analysis</h3>
        <p class="book-author">Richards J. Heuer Jr. (CIA)</p>
        <p class="book-if"><strong>Read this if:</strong> You need to separate signal from noise in high-stakes situations.</p>
        <blockquote class="book-quote">
          "Intelligence failures are rarely caused by a lack of information, but by the inability to process it correctly."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Analysis of Competing Hypotheses (ACH)</span>
        </div>
      </article>

      <article class="book-card">
        <div class="book-meta">
          <span class="book-number">14</span>
          <span class="book-tag">FORECASTING</span>
        </div>
        <h3>Superforecasting</h3>
        <p class="book-author">Philip Tetlock & Dan Gardner</p>
        <p class="book-if"><strong>Read this if:</strong> You think in certainties instead of probabilities.</p>
        <blockquote class="book-quote">
          "Foresight is not a mysterious gift; it is the product of particular ways of thinking."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Probabilistic thinking & belief updating</span>
        </div>
      </article>

      <article class="book-card wildcard">
        <div class="book-meta">
          <span class="book-number">15</span>
          <span class="book-tag">WILDCARD</span>
        </div>
        <h3>The Dice Man</h3>
        <p class="book-author">Luke Rhinehart</p>
        <p class="book-if"><strong>Read this if:</strong> You're too controlled, too predictable, too safe.</p>
        <blockquote class="book-quote">
          "I am large, I contain multitudes."
        </blockquote>
        <div class="book-framework">
          <span class="framework-label">Key Framework:</span>
          <span class="framework-name">Randomness as liberation from conditioned patterns</span>
        </div>
      </article>
    </div>
  </section>

  <!-- Prescription Quiz -->
  <section class="prescription-section" id="prescription">
    <h2>Not Sure Where to Start?</h2>
    <p class="prescription-intro">Answer three questions. Get your first book.</p>

    <div class="quiz-container">
      <div class="quiz-step active" data-step="1">
        <p class="quiz-question">What's your biggest frustration right now?</p>
        <div class="quiz-options">
          <button class="quiz-option" data-value="stuck">"We keep solving the same problems"</button>
          <button class="quiz-option" data-value="unclear">"We can't articulate the real issue"</button>
          <button class="quiz-option" data-value="paralyzed">"We know what to do but can't execute"</button>
        </div>
      </div>

      <div class="quiz-step" data-step="2">
        <p class="quiz-question">How complex is your situation?</p>
        <div class="quiz-options">
          <button class="quiz-option" data-value="simple">There's a right answer, we just need to find it</button>
          <button class="quiz-option" data-value="complicated">Multiple right answers, experts disagree</button>
          <button class="quiz-option" data-value="complex">Nobody knows, we're in uncharted territory</button>
        </div>
      </div>

      <div class="quiz-step" data-step="3">
        <p class="quiz-question">What's your default mode?</p>
        <div class="quiz-options">
          <button class="quiz-option" data-value="analytical">I analyze until I'm certain</button>
          <button class="quiz-option" data-value="intuitive">I trust my gut</button>
          <button class="quiz-option" data-value="collaborative">I ask everyone's opinion</button>
        </div>
      </div>

      <div class="quiz-result" id="quizResult">
        <!-- Populated by JS -->
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bookshelf-cta">
    <h2>Books Only Get You So Far</h2>
    <p>These frameworks come alive when applied to your specific situation.</p>
    <a href="mailto:dave@wordandmouth.com" class="cta-button">Open a Case File →</a>
  </section>
</Base>

<style>
  .bookshelf-hero {
    padding: 8rem 2rem 4rem;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    background: var(--accent);
    color: #000;
    padding: 0.25rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }

  .bookshelf-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .hero-sub {
    font-size: 1.2rem;
    color: #999;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-prescription {
    font-size: 1rem;
  }

  .hero-prescription a {
    color: var(--accent);
  }

  /* Section Headers */
  .book-section {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 3rem;
  }

  .section-icon {
    font-size: 2.5rem;
  }

  .section-header h2 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .section-desc {
    color: #888;
    font-size: 1rem;
  }

  /* Book Grid */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .book-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    padding: 2rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .book-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .book-card.wildcard {
    border-color: #ff4444;
    background: rgba(255,68,68,0.05);
  }

  .book-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .book-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    color: #555;
  }

  .book-tag {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.5rem;
    background: rgba(255,255,255,0.05);
    color: #888;
  }

  .book-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }

  .book-author {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .book-if {
    font-size: 0.95rem;
    color: #aaa;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .book-if strong {
    color: var(--accent);
  }

  .book-quote {
    font-style: italic;
    color: #777;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .book-framework {
    background: rgba(255,107,53,0.1);
    padding: 0.75rem 1rem;
    margin-top: 1rem;
  }

  .framework-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .framework-name {
    font-size: 0.85rem;
    color: #ccc;
  }

  /* Prescription Section */
  .prescription-section {
    padding: 6rem 2rem;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    border-top: 1px solid var(--border);
  }

  .prescription-section h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .prescription-intro {
    color: #888;
    margin-bottom: 3rem;
  }

  .quiz-container {
    text-align: left;
  }

  .quiz-step {
    display: none;
  }

  .quiz-step.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .quiz-question {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .quiz-option {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    color: #ccc;
    padding: 1rem 1.5rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 1rem;
  }

  .quiz-option:hover {
    border-color: var(--accent);
    background: rgba(255,107,53,0.1);
  }

  .quiz-result {
    display: none;
    text-align: center;
    padding: 2rem;
    background: rgba(255,107,53,0.1);
    border: 1px solid var(--accent);
    margin-top: 2rem;
  }

  .quiz-result.active {
    display: block;
    animation: fadeIn 0.5s ease;
  }

  .quiz-result h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .quiz-result p {
    color: #aaa;
  }

  .quiz-result .book-rec {
    color: var(--accent);
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1rem;
  }

  /* CTA */
  .bookshelf-cta {
    text-align: center;
    padding: 6rem 2rem;
    background: linear-gradient(180deg, transparent 0%, rgba(255,107,53,0.05) 100%);
  }

  .bookshelf-cta h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .bookshelf-cta p {
    color: #888;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .book-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script is:inline>
  const quizState = {
    step: 1,
    answers: {}
  };

  const recommendations = {
    'stuck-simple-analytical': { book: 'Good Strategy Bad Strategy', reason: 'You need to cut through the noise and find the kernel of real strategy.' },
    'stuck-complicated-analytical': { book: 'Thinking in Systems', reason: 'You\'re solving symptoms, not root causes. Learn to see the whole system.' },
    'stuck-complex-analytical': { book: 'Cynefin', reason: 'You\'re applying simple solutions to complex situations. Time to learn the difference.' },
    'unclear-simple-intuitive': { book: 'A More Beautiful Question', reason: 'You\'re jumping to answers. Learn to ask better questions first.' },
    'unclear-complicated-intuitive': { book: 'The Mom Test', reason: 'You\'re getting bad feedback. Learn to get the truth.' },
    'unclear-complex-intuitive': { book: 'Liminal Thinking', reason: 'Your beliefs are limiting you. Time to cross the threshold.' },
    'paralyzed-simple-collaborative': { book: 'Decisive', reason: 'You\'re stuck in analysis. Use the WRAP process to move.' },
    'paralyzed-complicated-collaborative': { book: 'The Pyramid Principle', reason: 'You know the answer but can\'t communicate it. Start with the answer.' },
    'paralyzed-complex-collaborative': { book: 'The Art of the Long View', reason: 'You can\'t predict the future, but you can rehearse for it.' },
    'default': { book: 'Finite and Infinite Games', reason: 'Before tactics, you need philosophy. This book reframes everything.' }
  };

  document.querySelectorAll('.quiz-option').forEach(btn => {
    btn.addEventListener('click', () => {
      const step = btn.closest('.quiz-step');
      const stepNum = parseInt(step.dataset.step);
      
      if (stepNum === 1) quizState.answers.frustration = btn.dataset.value;
      if (stepNum === 2) quizState.answers.complexity = btn.dataset.value;
      if (stepNum === 3) quizState.answers.mode = btn.dataset.value;

      step.classList.remove('active');

      if (stepNum < 3) {
        document.querySelector(`[data-step="${stepNum + 1}"]`).classList.add('active');
      } else {
        showResult();
      }
    });
  });

  function showResult() {
    const key = `${quizState.answers.frustration}-${quizState.answers.complexity}-${quizState.answers.mode}`;
    const rec = recommendations[key] || recommendations['default'];

    const result = document.getElementById('quizResult');
    result.innerHTML = `
      <h3>Your First Read:</h3>
      <p class="book-rec">${rec.book}</p>
      <p>${rec.reason}</p>
    `;
    result.classList.add('active');
  }
</script>
