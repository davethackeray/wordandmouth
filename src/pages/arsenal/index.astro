---
import Base from '../../layouts/Base.astro';
---

<Base title="Arsenal | Word And Mouth" description="Tools, resources, and wisdom for problem solvers.">
  <section class="arsenal-hero">
    <div class="hero-content">
      <a href="/methodology/" class="back-link">← How We Work</a>
      <h1>The Arsenal</h1>
      <p class="hero-subtitle">Books, podcasts, and tools for anyone serious about solving problems.</p>
    </div>
  </section>

  <section class="arsenal-grid-section">
    <div class="arsenal-grid">
      
      <a href="/arsenal/thinking-toolkit/" class="arsenal-card featured">
        <span class="arsenal-icon">🧠</span>
        <h3>Thinking Toolkit</h3>
        <p>40+ mental models, frameworks, and first principles for problem solving. From First Principles to Cynefin - plus where we've used them.</p>
        <span class="status-tag">New</span>
      </a>
      
      <a href="/arsenal/bookshelf/" class="arsenal-card">
        <span class="arsenal-icon">📚</span>
        <h3>The Bookshelf</h3>
        <p>15 books that shape how we think about problems. Grouped by problem type, with a prescription quiz to find your starting point.</p>
        <span class="status-tag">Available</span>
      </a>
      
      <a href="/arsenal/podcast/" class="arsenal-card">
        <span class="arsenal-icon">🎙️</span>
        <h3>What's Your Problem?</h3>
        <p>Conversations with people who found the problem behind the problem - and solved it.</p>
        <span class="status-tag coming">Coming Soon</span>
      </a>
      
      <a href="/arsenal/newsletter/" class="arsenal-card">
        <span class="arsenal-icon">📧</span>
        <h3>The Newsletter</h3>
        <p>Weekly doses of unexpected solutions, trivial catastrophes, and things you didn't know you needed to know.</p>
        <span class="status-tag coming">Coming Soon</span>
      </a>
      
    </div>
  </section>

</Base>

<style>
  .arsenal-hero {
    padding: 10rem 2rem 4rem;
    text-align: center;
    background: linear-gradient(180deg, #0a0a0a 0%, #111 100%);
  }

  .back-link {
    display: inline-block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .arsenal-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 500px;
    margin: 0 auto;
  }

  .arsenal-grid-section {
    padding: 3rem 2rem 5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .arsenal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .arsenal-card {
    background: #111;
    border: 1px solid var(--border);
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .arsenal-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .arsenal-card.featured {
    border-color: var(--accent);
  }

  .arsenal-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .arsenal-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .arsenal-card p {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
    flex-grow: 1;
  }

  .status-tag {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 600;
  }

  .status-tag.coming {
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .arsenal-hero {
      padding: 8rem 1.5rem 3rem;
    }
  }
</style>
