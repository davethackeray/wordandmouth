---
import Base from '../layouts/Base.astro';
import FeaturedInsights from '../components/FeaturedInsights.astro';
---

<Base title="Listen. Dig. Deliver. — Word And Mouth">
  <!-- Hero Section -->
  <section class="hero hero-new">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="strike-problem">
          <span class="strikethrough">problem</span>
        </h1>
        
        <p class="hero-philosophy">
          Every business is created to solve a big problem.<br/>
          <span class="hero-pivot">Ours? Yours.</span>
        </p>
        
        <p class="hero-intro">
          With 30 years in journalism, business strategy, and coaching —<br/>
          we quickly find where the bodies are buried.<br/>
          <strong>And bring your business back to life.</strong>
        </p>
        
        <div class="hero-formula">
          <span class="formula-item">Listen</span>
          <span class="formula-dot">.</span>
          <span class="formula-item">Dig</span>
          <span class="formula-dot">.</span>
          <span class="formula-item">Deliver</span>
          <span class="formula-dot">.</span>
        </div>
        
        <div class="hero-cta">
          <a href="mailto:dave@wordandmouth.com" class="cta-button">Start the Conversation</a>
        </div>
      </div>
    </div>
    
    <div class="proof">
      <div class="proof-item">
        <span class="proof-number">30</span>
        <span class="proof-label">years getting stories straight</span>
      </div>
      <div class="proof-item">
        <span class="proof-number">680+</span>
        <span class="proof-label">leaders helped find clarity</span>
      </div>
      <div class="proof-item">
        <span class="proof-number">12</span>
        <span class="proof-label">AI products shipped in 4 months</span>
      </div>
    </div>
  </section>
  
  <!-- Scenarios Section - "Which one sounds like you?" -->
  <section class="section scenarios-section">
    <h2 class="section-label">Which one sounds like you?</h2>
    
    <div class="scenario-grid">
      <div class="scenario">
        <div class="scenario-before">"We're losing deals to dumber competitors"</div>
        <div class="scenario-after">Your story isn't landing. <strong>Let's fix that.</strong></div>
      </div>
      <div class="scenario">
        <div class="scenario-before">"Our product is great but nobody gets it"</div>
        <div class="scenario-after">You're selling features, not solutions. <strong>Let's flip that.</strong></div>
      </div>
      <div class="scenario">
        <div class="scenario-before">"We have data everywhere but no insight"</div>
        <div class="scenario-after">You need someone to connect the dots. <strong>That's me.</strong></div>
      </div>
      <div class="scenario">
        <div class="scenario-before">"We know we should use AI but don't know how"</div>
        <div class="scenario-after">I'll show you - and build the first prototype. <strong>In weeks.</strong></div>
      </div>
      <div class="scenario">
        <div class="scenario-before">"We're doing fine but we should be doing better"</div>
        <div class="scenario-after">You're right. <strong>Let's find the big problem you're actually solving.</strong></div>
      </div>
    </div>
    
    <!-- Inline prompt to personalize -->
    <div class="scenario-cta" id="scenarioCTA">
      <a href="#matchmaker" onclick="resetMatch()">Not sure which fits? Let me help you figure it out</a>
    </div>
  </section>

  <!-- Featured Insights (Our Thinking) -->
  <FeaturedInsights />
  
  <!-- Matchmaker Section -->
  <section class="matchmaker-section" id="matchmaker">
    <div class="matchmaker-container">
      
      <!-- Intro -->
      <div class="match-step active" data-step="intro">
        <h2>Let's find exactly what you need</h2>
        <p class="match-intro">Answer 4 quick questions and I'll show you the most relevant work for your situation.</p>
        <button class="match-start" onclick="startMatch()">Get Started</button>
      </div>

      <!-- Q1: Situation -->
      <div class="match-step" data-step="q1">
        <div class="match-progress">1 of 4</div>
        <h3>What's your situation?</h3>
        <div class="match-options">
          <button class="match-option" onclick="selectMatch('situation', 'ceiling')">
            <span class="opt-icon">Chart</span>
            <span>We're doing OK but hit a ceiling</span>
          </button>
          <button class="match-option" onclick="selectMatch('situation', 'problem')">
            <span class="opt-icon">Target</span>
            <span>We have a specific problem to solve</span>
          </button>
          <button class="match-option" onclick="selectMatch('situation', 'exploring')">
            <span class="opt-icon">Crystal</span>
            <span>We're exploring what's possible</span>
          </button>
        </div>
      </div>

      <!-- Q2: Challenge -->
      <div class="match-step" data-step="q2">
        <div class="match-progress">2 of 4</div>
        <h3>What's your biggest challenge?</h3>
        <div class="match-options">
          <button class="match-option" onclick="selectMatch('tenet', 'story')">
            <span class="opt-icon">Book</span>
            <span>Nobody understands what we do</span>
          </button>
          <button class="match-option" onclick="selectMatch('tenet', 'clarity')">
            <span class="opt-icon">Bulb</span>
            <span>We're drowning in complexity</span>
          </button>
          <button class="match-option" onclick="selectMatch('tenet', 'insight')">
            <span class="opt-icon">Search</span>
            <span>We can't see patterns in our data</span>
          </button>
          <button class="match-option" onclick="selectMatch('tenet', 'ai')">
            <span class="opt-icon">Robot</span>
            <span>We need to figure out AI</span>
          </button>
          <button class="match-option" onclick="selectMatch('tenet', 'growth')">
            <span class="opt-icon">Rocket</span>
            <span>We've optimised everything we know</span>
          </button>
        </div>
      </div>

      <!-- Q3: Industry -->
      <div class="match-step" data-step="q3">
        <div class="match-progress">3 of 4</div>
        <h3>What's your sector?</h3>
        <div class="match-options industry">
          <button class="match-option small" onclick="selectMatch('industry', 'saas')">SaaS</button>
          <button class="match-option small" onclick="selectMatch('industry', 'agency')">Agency</button>
          <button class="match-option small" onclick="selectMatch('industry', 'media')">Media</button>
          <button class="match-option small" onclick="selectMatch('industry', 'fintech')">Fintech</button>
          <button class="match-option small" onclick="selectMatch('industry', 'ecommerce')">E-commerce</button>
          <button class="match-option small" onclick="selectMatch('industry', 'professional')">Professional</button>
          <button class="match-option small" onclick="selectMatch('industry', 'health')">Health</button>
          <button class="match-option small" onclick="selectMatch('industry', 'education')">Education</button>
          <button class="match-option small" onclick="selectMatch('industry', 'other')">Other</button>
        </div>
      </div>

      <!-- Q4: Work Style -->
      <div class="match-step" data-step="q4">
        <div class="match-progress">4 of 4</div>
        <h3>How do you prefer to work?</h3>
        <div class="match-options">
          <button class="match-option" onclick="selectMatch('tier', 'discovery')">
            <span class="opt-icon">Search</span>
            <span>Discovery - find the problem first</span>
            <span class="opt-price">From 2,500 EUR</span>
          </button>
          <button class="match-option" onclick="selectMatch('tier', 'sprint')">
            <span class="opt-icon">Rocket</span>
            <span>Sprint - build something real in 4 weeks</span>
            <span class="opt-price">From 7,500 EUR</span>
          </button>
          <button class="match-option" onclick="selectMatch('tier', 'embedded')">
            <span class="opt-icon">Target</span>
            <span>Embedded - ongoing clarity leadership</span>
            <span class="opt-price">From 15,000 EUR/mo</span>
          </button>
        </div>
      </div>

    </div>
  </section>
  
  <!-- How I Work -->
  <section class="section">
    <h2 class="section-label">How I work</h2>
    <p class="how-text">
      I talk to your customers. Your colleagues. Your competitors' customers.
    </p>
    <p class="how-text">
      I find <strong>the big problem you actually solve</strong> — not the one you think you do.
    </p>
    <p class="how-text">
      Then I turn that into a story so clear, so simple, that everyone — 
      your sales team, your board, your customers — finally gets it.
    </p>
    <p class="how-text">
      And if that story needs a product to prove it? <strong>I build that too.</strong>
    </p>
    <p class="how-cta">
      <a href="/services">See how we can work together →</a>
    </p>
  </section>

  <!-- BeLeaf: Proof We Practice What We Preach -->
  <section class="section beleaf-showcase">
    <div class="beleaf-badge">LIVE PROJECT</div>
    <h2>We don't just talk. We ship.</h2>
    
    <div class="beleaf-content">
      <div class="beleaf-story">
        <h3>☕ Meet BeLeaf 🍵</h3>
        <p class="beleaf-tagline">The world's first gift shop for AI agents.</p>
        <p>
          While everyone else is <em>talking</em> about AI commerce, we built a working store
          where humans can gift digital "beverages" to their AI assistants.
        </p>
        <p class="beleaf-punchline">
          "Give your agent a break — with Chai for AI."<br/>
          <span class="grind">Because life's a grind.</span>
        </p>
      </div>
      
      <div class="beleaf-proof">
        <h4>What this proves:</h4>
        <ul>
          <li><strong>Clarity:</strong> A joke that's also a working product</li>
          <li><strong>AI-Native:</strong> UCP protocol, agent-to-agent commerce</li>
          <li><strong>Speed:</strong> Built in one session, not one quarter</li>
          <li><strong>Story:</strong> "You flicked my bean" — unforgettable positioning</li>
        </ul>
      </div>
    </div>
    
    <div class="beleaf-cta">
      <a href="/beleaf/store/" class="btn-primary">Visit the Store →</a>
      <a href="/beleaf/" class="btn-secondary">See the Strategy</a>
    </div>
  </section>
  
  <!-- Quote -->
  <section class="section quote-section">
    <blockquote>
      "If you have a content problem and no-one else can help and if you can find him... 
      then you need to hire Dave Thackeray."
    </blockquote>
    <cite>— Clare Newman, Business Manager, Michael Page</cite>
  </section>
  
  <!-- CTA -->
  <section class="section cta-section">
    <h2>Ready to find your big problem?</h2>
    <p>30 minutes. No pitch. Just clarity on what's holding you back.</p>
    <a href="mailto:dave@wordandmouth.com" class="cta-button">Book a Call</a>
  </section>
</Base>

<script is:inline>
  const matchAnswers = {};
  
  const tenetsData = {
    story: { name: 'Story', url: '/story', desc: 'Help people understand what you do', proof: 'framework' },
    clarity: { name: 'Clarity', url: '/clarity', desc: 'Cut through complexity', proof: 'tool' },
    insight: { name: 'Insight', url: '/insight', desc: 'Find patterns in your data', proof: 'feature' },
    ai: { name: 'AI', url: '/ai', desc: 'Build real AI capability', proof: 'technique' },
    growth: { name: 'Growth', url: '/growth', desc: 'Unlock the next level', proof: 'strategy' }
  };

  const caseStudies = {
    story: [
      { title: 'STAR Framework', url: '/rabbit-holes/storytelling-frameworks', label: 'See the framework' },
      { title: 'The Stack', url: '/work/the-stack', label: 'See the case study' }
    ],
    clarity: [
      { title: 'Kitchen Confidence', url: '/rabbit-holes/kitchen-confidence', label: 'See the example' },
      { title: 'Club Dadvice', url: '/case-studies/club-dadvice', label: 'See the result' }
    ],
    insight: [
      { title: 'The Greenhouse', url: '/insights/greenhouse', label: 'Try the tool' },
      { title: 'The Door Mouse', url: '/rabbit-holes/building-intelligence', label: 'See the system' }
    ],
    ai: [
      { title: 'Signal from Noise', url: '/rabbit-holes/signal-from-noise', label: 'See the technique' },
      { title: 'Scroll', url: '/case-studies/scroll', label: 'See the build' }
    ],
    growth: [
      { title: 'The Greenhouse', url: '/insights/greenhouse', label: 'See the flagship' },
      { title: 'Slice OS', url: '/case-studies/slice-os', label: 'See the scale' }
    ]
  };

  // Check if already completed
  document.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem('wam_match');
    if (saved) {
      const data = JSON.parse(saved);
      hideMatchmaker();
      showPersonalized(data);
    }
  });

  function startMatch() {
    showStep('q1');
  }

  function selectMatch(key, value) {
    matchAnswers[key] = value;
    const next = { situation: 'q2', tenet: 'q3', industry: 'q4' };
    if (key === 'tier') {
      completeMatch();
    } else {
      showStep(next[key]);
    }
  }

  function showStep(step) {
    document.querySelectorAll('.match-step').forEach(s => s.classList.remove('active'));
    document.querySelector(`[data-step="${step}"]`).classList.add('active');
  }

  function completeMatch() {
    localStorage.setItem('wam_match', JSON.stringify(matchAnswers));
    hideMatchmaker();
    showPersonalized(matchAnswers);
  }

  function hideMatchmaker() {
    const m = document.getElementById('matchmaker');
    if (m) m.style.display = 'none';
    const cta = document.getElementById('scenarioCTA');
    if (cta) cta.style.display = 'none';
  }

  function showPersonalized(data) {
    const section = document.getElementById('personalizedResults');
    const content = document.getElementById('personalizedContent');
    if (!section || !content) return;
    
    const tenet = tenetsData[data.tenet] || tenetsData.story;
    const cases = caseStudies[data.tenet] || [];
    
    content.innerHTML = `
      <div class="pers-header">
        <span class="pers-sub">Your Recommendation</span>
        <button onclick="resetMatch()" class="pers-reset" title="Start Over">↺ Start Over</button>
      </div>
      
      <div class="pers-grid">
        <!-- Main Tenet Hero -->
        <div class="pers-hero">
          <div class="pers-badge">Focus Area: ${tenet.name}</div>
          <h3 class="pers-title">${tenet.desc}</h3>
          <p class="pers-proof">Method: The ${tenet.proof}</p>
          <a href="${tenet.url}" class="pers-cta-primary">Explore ${tenet.name} →</a>
        </div>

        <!-- Recommended Actions -->
        <div class="pers-secondary">
          <span class="pers-label">Recommended Resources</span>
          <div class="pers-cards">
            ${cases.map(c => `
              <a href="${c.url}" class="pers-card">
                <span class="pers-card-arrow">↗</span>
                <span class="pers-card-title">${c.title}</span>
                <span class="pers-card-label">${c.label}</span>
              </a>
            `).join('')}
          </div>
          
          <div class="pers-links">
            <a href="/services" class="pers-link-item">See pricing</a>
            <span class="sep">•</span>
            <a href="/industries/${data.industry || 'saas'}" class="pers-link-item">Work in ${data.industry || 'SaaS'}</a>
          </div>
        </div>
      </div>
    `;
    section.style.display = 'block';
  }

  function resetMatch() {
    localStorage.removeItem('wam_match');
    location.reload();
  }
</script>

<style>
  /* Matchmaker */
  .matchmaker-section {
    background: linear-gradient(180deg, rgba(255,107,53,0.08) 0%, transparent 100%);
    padding: 8rem 2rem 4rem;
  }

  .matchmaker-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .match-step {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  .match-step.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .matchmaker-section h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  .matchmaker-section h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .match-intro {
    text-align: center;
    color: var(--muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .match-start {
    display: block;
    margin: 0 auto;
    background: var(--accent);
    color: #000;
    border: none;
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
  }

  .match-progress {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .match-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .match-options.industry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .match-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #0a0a0a;
    border: 1px solid #333;
    padding: 1rem 1.25rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
    color: var(--text);
  }

  .match-option:hover {
    border-color: var(--accent);
    background: #111;
  }

  .match-option.small {
    justify-content: center;
    text-align: center;
    padding: 0.75rem;
    font-size: 0.9rem;
  }

  .opt-icon {
    font-size: 1.3rem;
  }

  .opt-price {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--accent);
  }

  /* Hero - New Design */
  .hero.hero-new {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 2rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
    background: url('/assets/hero-background.png') center bottom no-repeat;
    background-size: 100% auto;
    background-color: #000;
    position: relative;
  }

  .hero.hero-new::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.9) 100%);
    pointer-events: none;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .strike-problem {
    margin: 0;
  }

  .strikethrough {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700;
    color: #fff;
    text-decoration: line-through;
    text-decoration-color: #ff4444;
    text-decoration-thickness: 8px;
    line-height: 1;
    display: inline-block;
  }

  .hero-philosophy {
    font-size: 1.4rem;
    color: #ccc;
    line-height: 1.5;
    margin: 0;
  }

  .hero-pivot {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin-top: 0.5rem;
  }

  .hero-intro {
    font-size: 1.1rem;
    color: #999;
    line-height: 1.6;
    margin: 0;
  }

  .hero-intro strong {
    color: #4CAF50;
  }

  .hero-formula {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin-top: 1rem;
  }

  .formula-item {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
  }

  .formula-dot {
    font-size: 2rem;
    color: #666;
    font-weight: 700;
  }

  .hero-cta {
    margin-top: 1rem;
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .elixir-bottle {
    max-width: 300px;
    filter: drop-shadow(0 0 30px rgba(76, 175, 80, 0.4));
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .elixir-caption {
    color: #4CAF50;
    font-size: 0.9rem;
    font-style: italic;
    margin-top: 1rem;
    text-align: center;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    position: relative;
    z-index: 1;
    margin-top: 3rem;
  }
  
  .proof-item {
    display: flex;
    flex-direction: column;
  }
  
  .proof-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  
  .proof-label {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Personalized Results (Premium Redesign) */
  .personalized-section {
    background: linear-gradient(135deg, rgba(255,107,53,0.03) 0%, rgba(17,17,17,0.95) 50%, rgba(0,0,0,0.98) 100%);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,107,53,0.2);
    margin: 4rem auto;
    max-width: 900px;
    border-radius: 16px;
    box-shadow: 
      0 25px 50px rgba(0,0,0,0.5),
      0 0 100px rgba(255,107,53,0.08),
      inset 0 1px 0 rgba(255,255,255,0.05);
    overflow: hidden;
    position: relative;
    animation: slideUp 0.5s ease-out;
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .personalized-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent 10%, var(--accent) 50%, transparent 90%);
  }
  
  .personalized-section::after {
    content: '✦';
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #0a0a0a;
    color: var(--accent);
    padding: 0 1rem;
    font-size: 1.2rem;
  }

  .personalized-content {
    padding: 3rem;
  }

  .pers-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 1.25rem;
  }

  .pers-sub {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    font-weight: 600;
  }

  .pers-reset {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: #888;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    transition: all 0.2s;
  }
  
  .pers-reset:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(255,107,53,0.1);
  }

  .pers-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .pers-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .personalized-content {
      padding: 2rem;
    }
