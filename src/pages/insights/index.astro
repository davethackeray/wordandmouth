---
import Base from '../../layouts/Base.astro';

// Real content from AI Today podcast and Medium archive
const content = [
  // Featured Articles
  {
    type: 'blog',
    title: "The trivial matters more than you think",
    reason: "How a missing comma cost $5M, a typo crashed Wall Street, and what this means for your business",
    tenet: 'Clarity',
    date: '2026-01-13',
    readTime: '8 min',
    url: '/insights/trivial-catastrophe/'
  },
  {
    type: 'blog',
    title: "The £15M Paradox",
    reason: "A radio station that loses money on purpose — and why it's genius",
    tenet: 'Insight',
    date: '2026-01-13',
    readTime: '10 min',
    url: '/insights/the-15m-paradox/'
  },
  // AI Today Podcast Episodes
  {
    type: 'podcast',
    title: "10x your AI results with this ultimate context engineering lesson",
    reason: "The single most important skill for getting great output from AI",
    tenet: 'AI',
    date: '2025-10-18',
    duration: '14 min',
    url: 'https://podcasts.apple.com/us/podcast/10x-your-ai-results-with-this-ultimate-context-engineering/id1770010162'
  },
  {
    type: 'podcast',
    title: "When's the right time to go all-in with AI?",
    reason: "Karpathy vs Pichai — a debate on AI readiness for business",
    tenet: 'AI',
    date: '2025-10-18',
    duration: '14 min',
    url: 'https://podcasts.apple.com/us/podcast/whens-the-right-time-to-go-all-in-with-ai/id1770010162?i=1000732417476'
  },
  {
    type: 'blog',
    title: "42 years to build my first app",
    reason: "My journey from journalist to AI builder — and what it taught me about late bloomers",
    tenet: 'Story',
    date: '2025-03-15',
    readTime: '8 min',
    url: 'https://medium.com/@davethackeray'
  },
  {
    type: 'podcast',
    title: "ELephantLM: the AI that never forgets!",
    reason: "An LLM that learns from its mistakes — game changer for agents",
    tenet: 'AI',
    date: '2025-10-13',
    duration: '38 min',
    url: 'https://podcasts.apple.com/us/podcast/elephantlm-the-ai-that-never-forgets/id1770010162?i=1000731577171'
  },
  {
    type: 'blog',
    title: "Chain of thought prompting: the technique that changed everything",
    reason: "Early AI adoption proof — I was writing about this before it was cool",
    tenet: 'AI',
    date: '2024-06-20',
    readTime: '5 min',
    url: 'https://medium.com/@davethackeray'
  },
  {
    type: 'podcast',
    title: "brAIn: thinking of the future?",
    reason: "Dragon Hatchling — a paper that reboots how we think about AI architecture",
    tenet: 'Insight',
    date: '2025-10-01',
    duration: '30 min',
    url: 'https://podcasts.apple.com/us/podcast/brain-thinking-of-the-future/id1770010162?i=1000729566673'
  },
  {
    type: 'blog',
    title: "Why the Core Model changed my life",
    reason: "Still the best information architecture framework I know",
    tenet: 'Clarity',
    date: '2018-09-12',
    readTime: '6 min',
    url: 'https://medium.com/@davethackeray'
  },
  {
    type: 'podcast',
    title: "Does AI work?",
    reason: "OpenAI's GDPval research — LLMs in the organisation, tested",
    tenet: 'AI',
    date: '2025-09-26',
    duration: '27 min',
    url: 'https://podcasts.apple.com/us/podcast/does-ai-work/id1770010162?i=1000728592863'
  },
  {
    type: 'blog',
    title: "How to execute a content strategy",
    reason: "The evergreen playbook — still my most practical piece",
    tenet: 'Growth',
    date: '2018-04-15',
    readTime: '7 min',
    url: 'https://medium.com/@davethackeray'
  },
  {
    type: 'podcast',
    title: "China's got AI in the bag",
    reason: "30 years journalism + months of research — who's really winning the AI race?",
    tenet: 'Insight',
    date: '2025-09-14',
    duration: '24 min',
    url: 'https://podcasts.apple.com/us/podcast/chinas-got-ai-in-the-bag/id1770010162?i=1000726772753'
  },
  {
    type: 'podcast',
    title: "I'm working on the Zeitgeist",
    reason: "Building a business intelligence platform with AI — the toughest project of my career",
    tenet: 'AI',
    date: '2025-09-03',
    duration: '19 min',
    url: 'https://podcasts.apple.com/us/podcast/im-working-on-the-zeitgeist/id1770010162?i=1000724729646'
  },
  {
    type: 'blog',
    title: "Start storyselling (stop storytelling)",
    reason: "Why narrative without strategy is just entertainment",
    tenet: 'Story',
    date: '2012-02-10',
    readTime: '4 min',
    url: 'https://medium.com/@davethackeray'
  }
];

const typeIcons = {
  blog: '📝',
  podcast: '🎙️',
  video: '🎬'
};

const typeLabels = {
  blog: 'Read',
  podcast: 'Listen',
  video: 'Watch'
};
---

<Base title="Play" description="Ideas, insights, and explorations — AI Today podcast + 16 years of writing">
  <section class="hero-play">
    <h1>The <span class="highlight">River</span>.</h1>
    <p>Ideas flow here. 90 podcast episodes. 16 years of writing. Filter by mood — or let the current carry you.</p>
  </section>
  
  <!-- Filter Bar -->
  <section class="filter-section">
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="blog">📝 Read</button>
      <button class="filter-btn" data-filter="podcast">🎙️ Listen</button>
    </div>
    <div class="tenet-filters">
      <button class="tenet-btn" data-tenet="Story">Story</button>
      <button class="tenet-btn" data-tenet="Clarity">Clarity</button>
      <button class="tenet-btn" data-tenet="Insight">Insight</button>
      <button class="tenet-btn" data-tenet="AI">AI</button>
      <button class="tenet-btn" data-tenet="Growth">Growth</button>
    </div>
  </section>
  
  <!-- The River -->
  <section class="river-section">
    <div class="river">
      {content.map((item) => {
        const isExternal = item.url.startsWith('http');
        return (
          <a href={item.url} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener" : undefined} class="river-item" data-type={item.type} data-tenet={item.tenet}>
            <div class="item-meta">
              <span class="type-icon" title={typeLabels[item.type]}>{typeIcons[item.type]}</span>
              <span class="tenet-tag">{item.tenet}</span>
              <span class="item-date">{item.date}</span>
            </div>
            <h2 class="item-title">{item.title}</h2>
            <p class="item-reason">{item.reason}</p>
            <div class="item-footer">
              <span class="item-duration">
                {item.type === 'blog' ? item.readTime : item.duration}
              </span>
              <span class="item-action">{typeLabels[item.type]} →</span>
            </div>
          </a>
        );
      })}
    </div>
    
    <div class="river-empty" style="display: none;">
      <p>Nothing here yet matching that filter. Try another?</p>
    </div>
  </section>
  
  <!-- More Content Links -->
  <section class="section more-section">
    <h2 class="section-label">Want More?</h2>
    <div class="more-links">
      <a href="https://podcasts.apple.com/us/podcast/ai-today/id1770010162" target="_blank" class="more-link">
        <span class="more-icon">🎙️</span>
        <div>
          <strong>AI Today Podcast</strong>
          <span>90 episodes and counting</span>
        </div>
      </a>
      <a href="https://medium.com/@davethackeray" target="_blank" class="more-link">
        <span class="more-icon">📝</span>
        <div>
          <strong>Medium Archive</strong>
          <span>1,800+ posts since 2009</span>
        </div>
      </a>
    </div>
  </section>
  
  <!-- Subscribe -->
  <section class="section subscribe-section">
    <div class="subscribe-box">
      <h2>Don't miss the good stuff</h2>
      <p>Get notified when new ideas flow through.</p>
      <a href="mailto:dave@wordandmouth.com?subject=Subscribe to The River" class="cta-button">Subscribe</a>
    </div>
  </section>
</Base>

<style>
  .hero-play {
    padding: 10rem 2rem 3rem;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hero-play h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 1rem;
  }
  
  .hero-play p {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
  }
  
  .filter-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .filter-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 0.6rem 1.2rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  
  .tenet-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tenet-btn {
    background: transparent;
    border: none;
    color: var(--muted);
    padding: 0.4rem 0.8rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 0.2s;
  }
  
  .tenet-btn:hover,
  .tenet-btn.active {
    color: var(--accent);
  }
  
  .river-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }
  
  .river {
    display: grid;
    gap: 1px;
    background: var(--border);
  }
  
  .river-item {
    display: block;
    background: var(--bg);
    padding: 2rem;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  
  .river-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: transparent;
    transition: background 0.2s;
  }
  
  .river-item:hover {
    background: #111;
  }
  
  .river-item:hover::before {
    background: var(--accent);
  }
  
  .item-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  
  .type-icon {
    font-size: 1.2rem;
  }
  
  .tenet-tag {
    background: rgba(255, 107, 53, 0.15);
    color: var(--accent);
    padding: 0.2rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .item-date {
    font-size: 0.8rem;
    color: var(--muted);
    margin-left: auto;
  }
  
  .item-title {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  
  .item-reason {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  
  .item-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .item-duration {
    font-size: 0.85rem;
    color: var(--muted);
  }
  
  .item-action {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.2s;
  }
  
  .river-item:hover .item-action {
    opacity: 1;
    transform: translateX(0);
  }
  
  .river-empty {
    padding: 4rem 2rem;
    text-align: center;
    color: var(--muted);
    font-style: italic;
  }
  
  .river-item.hidden {
    display: none;
  }
  
  .more-section {
    border-top: none;
  }
  
  .more-links {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  
  .more-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #111;
    padding: 1.5rem;
    border-left: 3px solid transparent;
    transition: all 0.2s;
  }
  
  .more-link:hover {
    border-left-color: var(--accent);
  }
  
  .more-icon {
    font-size: 2rem;
  }
  
  .more-link strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
  }
  
  .more-link span {
    color: var(--muted);
    font-size: 0.85rem;
  }
  
  .subscribe-section {
    text-align: center;
  }
  
  .subscribe-box {
    background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);
    padding: 3rem;
    border: 1px solid var(--border);
  }
  
  .subscribe-box h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .subscribe-box p {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  
  @media (max-width: 600px) {
    .river-item {
      padding: 1.5rem;
    }
    
    .item-title {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // Filter functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const tenetBtns = document.querySelectorAll('.tenet-btn');
    const riverItems = document.querySelectorAll('.river-item');
    const riverEmpty = document.querySelector('.river-empty');
    
    let activeType = 'all';
    let activeTenet = null;
    
    function filterContent() {
      let visibleCount = 0;
      
      riverItems.forEach(item => {
        const itemType = item.dataset.type;
        const itemTenet = item.dataset.tenet;
        
        const typeMatch = activeType === 'all' || itemType === activeType;
        const tenetMatch = !activeTenet || itemTenet === activeTenet;
        
        if (typeMatch && tenetMatch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });
      
      if (riverEmpty) {
        riverEmpty.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeType = btn.dataset.filter;
        filterContent();
      });
    });
    
    tenetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('active')) {
          btn.classList.remove('active');
          activeTenet = null;
        } else {
          tenetBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeTenet = btn.dataset.tenet;
        }
        filterContent();
      });
    });
  });
</script>
