---
import Base from '../layouts/Base.astro';
---

<Base title="Proof" description="What 680+ people say about working with Dave">
  <section class="hero-small">
    <h1>Don't take my word for it.</h1>
    <p>680+ recommendations. 48 LinkedIn endorsements. 18 years of proof.</p>
  </section>
  
  <!-- Featured Quote -->
  <section class="section">
    <blockquote class="featured-quote">
      "If you have a content problem and no-one else can help and if you can find him... 
      then you need to hire Dave Thackeray."
    </blockquote>
    <cite>— Clare Newman, Business Manager, Michael Page</cite>
  </section>
  
  <!-- Patterns -->
  <section class="section">
    <h2 class="section-label">The Patterns</h2>
    <div class="patterns">
      <div class="pattern">
        <h3>Prepared & Invested</h3>
        <p>"Reviewed my work before the call," "sent meeting notes after"</p>
      </div>
      <div class="pattern">
        <h3>Energising</h3>
        <p>"Full of energy," "infectious enthusiasm," "better than a can of red bull"</p>
      </div>
      <div class="pattern">
        <h3>Actionable</h3>
        <p>"Practical advice I can use right away," "step-by-step strategy"</p>
      </div>
      <div class="pattern">
        <h3>Idea Machine</h3>
        <p>"Volume and practicality of his ideas — he's a machine!"</p>
      </div>
      <div class="pattern">
        <h3>Question Architecture</h3>
        <p>"Asks the right questions," "great questioning technique"</p>
      </div>
    </div>
  </section>
  
  <!-- Selected Testimonials -->
  <section class="section">
    <h2 class="section-label">From Colleagues & Clients</h2>
    
    <div class="testimonials">
      <div class="testimonial">
        <blockquote>
          "What sets him apart from anyone I've ever met is the volume and practicality 
          of his ideas. He's a machine!"
        </blockquote>
        <cite>— John Scotland, Digital Content Producer</cite>
      </div>
      
      <div class="testimonial">
        <blockquote>
          "Dave has an unparalleled knack for breaking down departmental silos and 
          tapping into the pulse of the organisation. His commitment to delighting 
          customers and solving business problems is unwavering."
        </blockquote>
        <cite>— Jake Hounsell, Senior Content Designer, UK Home Office</cite>
      </div>
      
      <div class="testimonial">
        <blockquote>
          "Better than a can of red bull frankly! His style is supportive, creative, 
          collaborative and exceptionally encouraging."
        </blockquote>
        <cite>— Kath Roberts, Systems Coach</cite>
      </div>
      
      <div class="testimonial">
        <blockquote>
          "He finds the essence of a brand and makes it simple to understand."
        </blockquote>
        <cite>— Ben Gross, Director, Electric Circus Digital</cite>
      </div>
    </div>
  </section>
  
  <section class="section">
    <h2 class="section-label">From Mentees</h2>
    
    <div class="testimonials">
      <div class="testimonial">
        <blockquote>
          "Dave is a mentor who reviewed your work before the call and sent over meeting 
          notes after the session. He genuinely cares for the mentees he speaks to."
        </blockquote>
        <cite>— Jing Hu, Director, A&H Consulting</cite>
      </div>
      
      <div class="testimonial">
        <blockquote>
          "I came to him in full interview panic mode, and he helped calm my nerves, 
          build my confidence, and gave me super helpful advice. He's incredibly sharp."
        </blockquote>
        <cite>— Sidra Sipra, Project Manager, Arden University</cite>
      </div>
      
      <div class="testimonial">
        <blockquote>
          "David's been a massive help in tutoring me on AI. He even taught me how to 
          produce an app — something I didn't even know was possible for someone with 
          a non-developing background!"
        </blockquote>
        <cite>— Joanna Gresty, Community Engagement Officer, Home Instead</cite>
      </div>
    </div>
  </section>
  
  <!-- Numbers -->
  <section class="section numbers-section">
    <div class="numbers">
      <div class="number">
        <span>680+</span>
        <label>ADPList Recommendations</label>
      </div>
      <div class="number">
        <span>48</span>
        <label>LinkedIn Recommendations</label>
      </div>
      <div class="number">
        <span>20+</span>
        <label>Countries Represented</label>
      </div>
      <div class="number">
        <span>18</span>
        <label>Years of Feedback</label>
      </div>
    </div>
  </section>
  
  <section class="section cta-section">
    <h2>Ready to experience this yourself?</h2>
    <a href="mailto:dave@wordandmouth.com" class="cta-button">Let's Talk</a>
  </section>
</Base>

<style>
  .hero-small {
    padding: 10rem 2rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .hero-small h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }
  
  .hero-small p {
    color: var(--muted);
    font-size: 1.2rem;
  }
  
  .featured-quote {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
  }
  
  cite {
    display: block;
    font-style: normal;
    color: var(--muted);
    font-size: 0.9rem;
  }
  
  .patterns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  
  .pattern {
    background: #111;
    padding: 1.5rem;
  }
  
  .pattern h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }
  
  .pattern p {
    font-size: 0.9rem;
    color: var(--muted);
    font-style: italic;
  }
  
  .testimonials {
    display: grid;
    gap: 2rem;
  }
  
  .testimonial {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  
  .testimonial blockquote {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }
  
  .numbers-section {
    text-align: center;
  }
  
  .numbers {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 3rem;
  }
  
  .number span {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  
  .number label {
    font-size: 0.85rem;
    color: var(--muted);
  }
  
  .cta-section {
    text-align: center;
  }
  
  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }
</style>
